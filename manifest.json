{
  "name": "Extftcad",
  "description": "Упрощает текст с помощью ИИ",
  "version": "1.0.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:5055/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["miniwindow/miniwindow.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
  {
    "resources": ["miniwindow/miniwindow.html", "miniwindow/miniwindow.css", "shared-ui.css", "src/icon.png", "src/arrow_back.svg"],
    "matches": ["<all_urls>"]
  }
]
}
